# ===========================================
# 川上食品 HACCP管理システム - 本番環境設定
# ===========================================
# このファイルを .env.production にコピーして値を設定してください
# cp .env.production.example .env.production

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# --- Application ---
# DATABASE_URL is auto-constructed in docker-compose.yml — do not set here
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# --- Optional ---
# APP_PORT=3000
